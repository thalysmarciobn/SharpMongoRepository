root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 4

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# `var` where the type is evident from the right-hand side, which is this codebase's style.
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:silent

# Expression bodies read better for the many one-line forwarding members in this library.
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_accessors = true:silent
csharp_style_expression_bodied_constructors = false:silent
csharp_style_expression_bodied_lambdas = true:silent

# Braces are optional on a single embedded statement; the codebase omits them for guard clauses.
csharp_prefer_braces = when_multiline:silent

# Modern language features this library relies on.
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
csharp_style_prefer_utf8_string_literals = true:suggestion
csharp_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_style_namespace_match_folder = false

# Readability rules worth enforcing.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
csharp_prefer_static_local_function = true:warning
csharp_style_prefer_readonly_struct = true:suggestion

# Naming: types and members PascalCase, private fields _camelCase, constants PascalCase.
dotnet_naming_rule.types_and_members.severity = warning
dotnet_naming_rule.types_and_members.symbols = types_and_members_symbols
dotnet_naming_rule.types_and_members.style = pascal_case_style
dotnet_naming_symbols.types_and_members_symbols.applicable_kinds = class,struct,interface,enum,delegate,method,property,event
dotnet_naming_symbols.types_and_members_symbols.applicable_accessibilities = *

dotnet_naming_rule.constant_fields.severity = warning
dotnet_naming_rule.constant_fields.symbols = constant_field_symbols
dotnet_naming_rule.constant_fields.style = pascal_case_style
dotnet_naming_symbols.constant_field_symbols.applicable_kinds = field
dotnet_naming_symbols.constant_field_symbols.applicable_accessibilities = *
dotnet_naming_symbols.constant_field_symbols.required_modifiers = const

dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_rule.private_fields.symbols = private_field_symbols
dotnet_naming_rule.private_fields.style = underscore_camel_case_style
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_symbols.private_field_symbols.required_modifiers =

dotnet_naming_rule.static_readonly_fields.severity = warning
dotnet_naming_rule.static_readonly_fields.symbols = static_readonly_field_symbols
dotnet_naming_rule.static_readonly_fields.style = pascal_case_style
dotnet_naming_symbols.static_readonly_field_symbols.applicable_kinds = field
dotnet_naming_symbols.static_readonly_field_symbols.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_field_symbols.required_modifiers = static,readonly

dotnet_naming_style.pascal_case_style.capitalization = pascal_case
dotnet_naming_style.underscore_camel_case_style.capitalization = camel_case
dotnet_naming_style.underscore_camel_case_style.required_prefix = _

# Analyzer rules that do not fit a library of this shape.
# CA1716: "Delete" and similar names clash with VB keywords; the driver's own API uses them.
dotnet_diagnostic.CA1716.severity = none
# CA1848 / CA2254: LoggerMessage source generators are not worth it for the handful of cold start-up
# log calls in this library.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA2254.severity = none
# CA1873: the only flagged call sites are start-up index diagnostics, run once per process.
dotnet_diagnostic.CA1873.severity = none
# CA1000: static members on a generic type are the entire point of MongoIndexes<TDocument, TKey>.
# A typed index factory cannot be expressed without them.
dotnet_diagnostic.CA1000.severity = none

# IDE0046 / IDE0270 turn a readable chain of guard clauses into nested ternaries. Kept as hints.
dotnet_diagnostic.IDE0046.severity = silent
dotnet_diagnostic.IDE0270.severity = silent

[Tests/**.cs]
# Test method names read as sentences, and test classes do not need documentation.
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
# IDE0039: some tests hold a delegate in a variable on purpose, to prove the delegate shape works.
dotnet_diagnostic.IDE0039.severity = none
# CA1859: tests deliberately go through IMongoRepository, because that is the published contract.
dotnet_diagnostic.CA1859.severity = none

[Examples/**.cs]
dotnet_diagnostic.CS1591.severity = none
