<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
          net8.0 is LTS and still the most deployed runtime, net10.0 is the current
          LTS. Targeting all three lets the compiler light up the newer, cheaper
          code paths (System.Threading.Lock, params ReadOnlySpan<T>) without
          dropping anyone.
        -->
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>

        <!--
          Transitive pinning is off for the packaged project. With it on, a PackageVersion entry for a
          transitive dependency is promoted into this package's own dependency list, so a pin added later
          for a test-only package would silently appear as a dependency of the library. The other projects
          keep pinning, because nothing they resolve is published.
        -->
        <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <PropertyGroup Label="Package">
        <PackageId>SharpMongoRepository</PackageId>
        <Version>0.1.0</Version>
        <Title>SharpMongoRepository</Title>
        <Authors>ThalysMarcioBN</Authors>
        <Company>ThalysMarcioBN</Company>
        <Description>A MongoDB repository for .NET: CRUD, partial updates, projections, streaming reads, bulk writes, retrying transactions and declarative index management. Shares a single pooled MongoClient, honours CancellationToken end to end, and creates indexes once at startup instead of once per request.</Description>
        <PackageProjectUrl>https://github.com/thalysmarciobn/SharpMongoRepository</PackageProjectUrl>
        <RepositoryUrl>https://github.com/thalysmarciobn/SharpMongoRepository.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>mongodb;mongo;repository;database;nosql;dotnet</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>See CHANGELOG.md. 0.1.0 contains breaking changes; the file lists each one with its migration.</PackageReleaseNotes>
    </PropertyGroup>

    <PropertyGroup Label="Symbols and SourceLink">
        <!--
          SourceLink ships in the SDK from .NET 8 onwards, so no package reference is needed. The
          Microsoft.SourceLink.GitHub package pulls Microsoft.Build.Tasks.Git, which carries an advisory.
          Without SourceLink the published .snupkg cannot step into library code.
        -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <ItemGroup>
        <!-- One README only: two files packed to \README.md used to collide (NU5118). -->
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <!-- The test project asserts on internals such as IdAssigner and MongoIndexEnsurer. -->
        <InternalsVisibleTo Include="Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MongoDB.Bson" />
        <PackageReference Include="MongoDB.Driver" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Options" />
    </ItemGroup>

</Project>
